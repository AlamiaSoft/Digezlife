includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - packages/alamia-core/src/
    
    level: 5

    ignoreErrors:
        - '#Unsafe usage of new static.*#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::.*#'
        - '#Call to an undefined method Illuminate\\Database\\Schema\\Blueprint::.*#'
        
    reportUnmatchedIgnoredErrors: false

    excludePaths:
        - packages/alamia-core/src/*/Tests/*
        - packages/alamia-core/src/*/Database/Migrations/*
